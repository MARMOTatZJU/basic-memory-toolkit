# Basic Memory runtime ignore profile for the two authored databases.
# Install this file as <BASIC_MEMORY_CONFIG_DIR>/.bmignore.
# The default exclusions are repeated because Basic Memory replaces its defaults
# when a nonempty .bmignore file exists.

# Hidden files and version-control metadata
.*
.git
.svn

# Basic Memory runtime state
*.db
*.db-shm
*.db-wal
config.json

# Python and build artifacts
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.coverage
*.egg-info
.tox
.mypy_cache
.ruff_cache
.venv
venv
env
.env
build
dist
.cache

# Node.js, editors, and operating-system artifacts
node_modules
.idea
.vscode
.DS_Store
Thumbs.db
desktop.ini
.obsidian

# Temporary files
*.tmp
*.swp
*.swo
*~

# Derived database catalogs. Markdown remains the authored runtime corpus.
index.json
graph.json
# Keep registry/source-inventory.json because authored Markdown links to it.
registry/aliases.json
registry/evidence-roots.json
registry/message-manifest.json
registry/provenance.json
registry/root-routes.json
registry/sync-coverage.json
registry/writing-policy.json
# Keep views/MotorcycleNotes.json because authored Markdown links to it.
views/domain-*.json
*/view.json
# Keep the motorcycle source manifest because authored Markdown links to it.

# Raw Codex evidence duplicates the authored conversation Markdown records.
evidence/
